# ==========================================
# FlacDL Telegram Bot Configuration
# ==========================================

# [REQUIRED] Your Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [OPTIONAL] Allowed Telegram User IDs (comma-separated, e.g. 12345678,87654321).
# If left blank, anyone can use the bot.
ALLOWED_USERS=

# [OPTIONAL] Admin Telegram User IDs (comma-separated).
# Admins have access to /doctor, /status, /setup_help, /broadcast, etc.
ADMIN_IDS=

# [LUCIDADL BINARY]
# Command to execute lucidadl ('lucida' or 'lucidadl'). Leave as 'auto' for auto-detection.
LUCIDA_BIN=auto

# [CONCURRENCY & PERFORMANCE]
# Maximum parallel active download jobs
MAX_CONCURRENT_DOWNLOADS=2

# Download timeout in seconds (default: 600s = 10 minutes)
DOWNLOAD_TIMEOUT_SECONDS=600

# [DEFAULT USER PREFERENCES]
# Default audio format ('flac', 'mp3', 'm4a', 'opus', 'ogg', 'wav')
DEFAULT_FORMAT=flac

# Default audio bitrate for lossy transcoding (e.g. '320k', '256k', '192k')
DEFAULT_BITRATE=320k

# Default service provider ('default', 'qobuz', 'amazon', 'grilledcheese')
DEFAULT_SERVICE=default

# [STORAGE & LIMITS]
# Base temporary download directory (isolated subfolders will be created per job)
TEMP_DOWNLOAD_DIR=/tmp/flacdl_bot

# Automatically delete downloaded files from disk after sending to Telegram (true/false)
CLEANUP_TEMP=true

# Telegram standard cloud bot API limit is 50MB (52428800 bytes).
# Set to true to automatically compress >50MB lossless files to 320kbps MP3 so they can be sent.
AUTO_COMPRESS_LARGE_FILES=true

# [LOCAL BOT API SERVER]
# If you run a custom local Telegram Bot API Server, you can send files up to 2000MB (2GB)!
# Provide the local server URL here, e.g., http://localhost:8081/bot
LOCAL_BOT_API_URL=

# SQLite database file for user preferences and download statistics
DB_PATH=bot_data.sqlite3
