# ====================================================================
# FlacDL Telethon MTProto Userbot Configuration (Google Cloud Shell)
# ====================================================================

# [REQUIRED] Telegram API credentials obtained from https://my.telegram.org (API development tools)
# Note: These are your App credentials, NOT a bot token!
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# [OPTIONAL] Your phone number in international format (+628123456789 or +1...)
# If not provided, you will be prompted interactively in the terminal on first login.
PHONE_NUMBER=

# [CRITICAL: PERSISTENT SESSION LOCATION FOR GOOGLE CLOUD SHELL]
# Google Cloud Shell only preserves data inside the user's $HOME directory.
# This path ensures your login session is NOT wiped when Cloud Shell restarts.
# (Telethon will automatically save to $HOME/.telethon_sessions/flacdl_userbot.session)
SESSION_NAME=flacdl_userbot

# [COMMANDS & SECURITY]
# Prefix for userbot commands (e.g. .flac, .upload, .status, .help)
COMMAND_PREFIX=.

# Allowed User IDs who can send commands to your userbot (comma-separated).
# If left blank, ONLY YOU (the account owner) can trigger commands.
ALLOWED_USERS=

# [LUCIDADL MUSIC DOWNLOAD CONFIGURATION]
# Binary command: 'auto', 'lucida', or 'lucidadl'
LUCIDA_BIN=auto

# Audio format: 'flac' (Lossless up to 24-bit), 'mp3', 'm4a', 'opus', 'ogg', 'wav'
DEFAULT_FORMAT=flac
DEFAULT_BITRATE=320k
DEFAULT_SERVICE=default

# Download directory inside persistent $HOME storage
TEMP_DOWNLOAD_DIR=/home/reii/t-server/downloads

# Automatically delete downloaded files from disk after sending to Telegram
CLEANUP_TEMP=true
